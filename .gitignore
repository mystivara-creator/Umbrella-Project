# Local / editor
*.swp
*.swo
.DS_Store
.idea/
.vscode/
__pycache__/
*.py[cod]

# Umbrella root-anchored workspace & output directories
# (Anchored with leading '/' so Linux kernel subdirectories such as tools/build/ are NEVER ignored)
/out/
/build/
/dist/
/.umbrella-workspace/
/bazel-*/

# Kernel build artifacts (when building in-tree without O=)
*.o
*.ko
*.cmd
*.mod
*.mod.c
*.dtb
*.dtbo
*.img
Module.symvers
modules.order
.tmp_versions/

# Local stock kernel configuration & private device baseline archives
/config/kernel/kunzite-stock.config
/umbrella-kunzite-test-baseline-*.tar.gz

# Explicit Umbrella governance & CI path protections (preserved across upstream Linux .gitignore merges)
!/.github/
!/.github/**
!/config/
!/config/**
!/docs/
!/docs/**
!/interfaces/
!/interfaces/**
!/patches/
!/patches/**
!/tests/
!/tests/**
!/tools/*.py
!/tools/*.sh
